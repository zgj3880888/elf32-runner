# 工程在 Windows 编辑、Linux(GitHub Actions) 构建，锁死换行防止引入 CRLF 把 CI 搞崩。
# 尤其 gradlew —— 一旦混进 CRLF，Linux 上会报 env: 'bash\r': No such file or directory。
*           text=auto eol=lf

# 必须保持 LF 的文本/脚本
*.java      text eol=lf
*.gradle    text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
*.pro       text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
gradlew     text eol=lf

# Windows 批处理必须 CRLF
*.bat       text eol=crlf

# 二进制
*.jar       binary
*.png       binary
*.apk       binary
*.zip       binary
hello_arm32 binary
sum_1_10    binary
